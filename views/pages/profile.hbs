<div class="profile-hero mb-4 animate-fade-in">
  <div class="d-flex align-items-center gap-3">
    <div class="hero-icon"><i class="fas fa-user-circle"></i></div>
    <div>
      <h4 class="mb-0 fw-bold text-white">Profil</h4>
      <small class="text-white opacity-75">Shaxsiy ma'lumotlaringizni boshqaring</small>
    </div>
  </div>
</div>

<div class="row g-4 animate-fade-in align-items-stretch">
  <!-- Left -->
  <div class="col-lg-4 d-flex flex-column gap-4 animate-slide-up">

    <!-- Avatar Card -->
    <div class="profile-card text-center">
      <div class="profile-avatar-wrap mb-3">
        {{#if user.profile}}
          <img src="/uploads/user-profile/{{user.profile}}" class="profile-avatar" alt="{{user.full_name}}">
        {{else}}
          <div class="profile-avatar-placeholder">
            <i class="fas fa-user"></i>
          </div>
        {{/if}}
        <form action="/profile/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
          <input type="file" name="profile" id="fileInput" accept="image/*" class="d-none"
            onchange="document.getElementById('uploadForm').submit()">
          <button type="button" class="avatar-upload-btn" onclick="document.getElementById('fileInput').click()">
            <i class="fas fa-camera"></i>
          </button>
        </form>
      </div>
      <h4 class="fw-bold mb-1">{{user.full_name}}</h4>
      <p class="text-muted small mb-3"><i class="fas fa-envelope me-1"></i>{{user.email}}</p>
      <span class="role-pill"><i class="fas fa-id-badge me-1"></i>{{user.role}}</span>
    </div>

    <!-- Telegram -->
    <div class="profile-section">
      <div class="section-header">
        <i class="fab fa-telegram"></i>
        <span>Telegram</span>
      </div>
      <div class="section-body">
        {{#if user.telegram_linked}}
          <div class="tg-status tg-connected">
            <i class="fas fa-check-circle fa-lg"></i>
            <div>
              <p class="mb-0 fw-semibold small">Telegram bog'langan</p>
              <small class="opacity-75">Bot orqali qabullarni boshqarishingiz mumkin</small>
            </div>
          </div>
        {{else}}
          <div class="tg-status tg-disconnected mb-3">
            <i class="fas fa-exclamation-triangle fa-lg"></i>
            <div>
              <p class="mb-0 fw-semibold small">Telegram bog'lanmagan</p>
              <small class="opacity-75">Bot orqali qabullarni boshqarish uchun bog'lang</small>
            </div>
          </div>
          <a href="https://t.me/{{botUsername}}?start=link_{{user._id}}" target="_blank" class="btn-telegram w-100">
            <i class="fab fa-telegram me-2"></i>Telegram'ni bog'lash
          </a>
        {{/if}}
      </div>
    </div>

    <!-- Security -->
    <div class="profile-section">
      <div class="section-header">
        <i class="fas fa-shield-alt"></i>
        <span>Xavfsizlik</span>
      </div>
      <div class="section-body p-0">
        <a href="/forgot-password" class="security-link">
          <div class="security-link-icon">
            <i class="fas fa-key"></i>
          </div>
          <div class="flex-grow-1">
            <p class="mb-0 fw-semibold small">Parolni o'zgartirish</p>
            <small class="text-muted">Hisobingiz xavfsizligini ta'minlang</small>
          </div>
          <i class="fas fa-chevron-right text-muted small"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- Right -->
  <div class="col-lg-8 animate-slide-up d-flex flex-column gap-4" style="animation-delay:0.1s">

    <!-- Edit Form -->
    <div class="profile-section">
      <div class="section-header">
        <i class="fas fa-edit"></i>
        <span>Ma'lumotlarni tahrirlash</span>
      </div>
      <div class="section-body">
        <form action="/profile/update" method="POST">
          <div class="modern-field">
            <label class="modern-label"><i class="fas fa-user"></i> To'liq ism</label>
            <input type="text" class="modern-input" name="full_name" value="{{user.full_name}}" required>
          </div>
          <div class="modern-field">
            <label class="modern-label"><i class="fas fa-envelope"></i> Email</label>
            <input type="email" class="modern-input disabled-input" value="{{user.email}}" disabled>
            <p class="field-hint"><i class="fas fa-lock me-1"></i>Email o'zgartirilmaydi</p>
          </div>
          <button type="submit" class="btn-save">
            <i class="fas fa-save me-2"></i>Saqlash
          </button>
        </form>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="profile-section flex-grow-1">
      <div class="section-header">
        <i class="fas fa-bolt"></i>
        <span>Tezkor havolalar</span>
      </div>
      <div class="section-body">
        <div class="row g-3">
          {{#if (eq user.role 'patient')}}
            <div class="col-sm-4">
              <a href="/doctors" class="quick-card quick-primary">
                <div class="quick-icon"><i class="fas fa-calendar-plus"></i></div>
                <span class="quick-title">Qabul yozish</span>
                <small class="quick-desc">Shifokorga yoziling</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/patient/appointments" class="quick-card quick-info">
                <div class="quick-icon"><i class="fas fa-calendar-check"></i></div>
                <span class="quick-title">Qabullarim</span>
                <small class="quick-desc">Barcha qabullar</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/doctors" class="quick-card quick-success">
                <div class="quick-icon"><i class="fas fa-user-md"></i></div>
                <span class="quick-title">Shifokorlar</span>
                <small class="quick-desc">Ro'yxatni ko'ring</small>
              </a>
            </div>
          {{else if (eq user.role 'doctor')}}
            <div class="col-sm-4">
              <a href="/doctor/appointments" class="quick-card quick-primary">
                <div class="quick-icon"><i class="fas fa-clipboard-list"></i></div>
                <span class="quick-title">Qabullar</span>
                <small class="quick-desc">Bemorlar ro'yxati</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/doctor/schedule" class="quick-card quick-info">
                <div class="quick-icon"><i class="fas fa-calendar-alt"></i></div>
                <span class="quick-title">Jadval</span>
                <small class="quick-desc">Ish jadvalingiz</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/doctors" class="quick-card quick-success">
                <div class="quick-icon"><i class="fas fa-user-md"></i></div>
                <span class="quick-title">Shifokorlar</span>
                <small class="quick-desc">Hamkasblar</small>
              </a>
            </div>
          {{else if (eq user.role 'admin')}}
            <div class="col-sm-4">
              <a href="/admin" class="quick-card quick-primary">
                <div class="quick-icon"><i class="fas fa-tachometer-alt"></i></div>
                <span class="quick-title">Dashboard</span>
                <small class="quick-desc">Umumiy ko'rinish</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/admin/users" class="quick-card quick-info">
                <div class="quick-icon"><i class="fas fa-users"></i></div>
                <span class="quick-title">Foydalanuvchilar</span>
                <small class="quick-desc">Boshqaruv paneli</small>
              </a>
            </div>
            <div class="col-sm-4">
              <a href="/admin/doctors" class="quick-card quick-success">
                <div class="quick-icon"><i class="fas fa-user-md"></i></div>
                <span class="quick-title">Shifokorlar</span>
                <small class="quick-desc">Boshqaruv paneli</small>
              </a>
            </div>
          {{/if}}
        </div>
      </div>
    </div>

  </div>
</div>

