<h1 class="mb-4">Bo'limlarni boshqarish</h1>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Yangi bo'lim qo'shish</h5>
        <form action="/admin/departments" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Bo'lim nomi</label>
            <input type="text" class="form-control" id="name" name="name" required>
          </div>
          <button type="submit" class="btn btn-primary">Qo'shish</button>
        </form>
      </div>
    </div>
  </div>
</div>

{{#if departments.length}}
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Nomi</th>
          <th>Amallar</th>
        </tr>
      </thead>
      <tbody>
        {{#each departments}}
          <tr>
            <td>{{this.name}}</td>
            <td>
              <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal{{this._id}}">Tahrirlash</button>
              <form action="/admin/departments/{{this._id}}/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Ishonchingiz komilmi?')">O'chirish</button>
              </form>
            </td>
          </tr>

          <!-- Edit Modal -->
          <div class="modal fade" id="editModal{{this._id}}" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Bo'limni tahrirlash</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/departments/{{this._id}}/update" method="POST">
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Bo'lim nomi</label>
                      <input type="text" class="form-control" name="name" value="{{this.name}}" required>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                    <button type="submit" class="btn btn-primary">Saqlash</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="alert alert-info">Hozircha bo'limlar yo'q.</div>
{{/if}}
