<div class="page-header sc-fade">
  <div class="page-header-left">
    <div class="page-header-icon green"><i class="fas fa-calendar-plus"></i></div>
    <div>
      <h2>Qabulga yozilish</h2>
      <p>Qulay vaqtni tanlang va qabulga yoziling</p>
    </div>
  </div>
</div>

<div class="row g-4 sc-slide">
  <!-- Doctor Info -->
  <div class="col-md-4">
    <div class="sc-card text-center doctor-info-card">
      <div class="doc-photo-wrap mb-3">
        {{#if doctor.user_id.profile}}
          <img src="/uploads/user-profile/{{doctor.user_id.profile}}"
            class="doc-photo" alt="{{doctor.user_id.full_name}}">
        {{else}}
          <div class="doc-photo-placeholder">
            <i class="fas fa-user-md"></i>
          </div>
        {{/if}}
      </div>
      <h5 class="fw-bold mb-1">{{doctor.user_id.full_name}}</h5>
      <p class="spec-tag mb-3">{{doctor.specialization}}</p>
      <div class="doc-stats">
        <div class="doc-stat">
          <i class="fas fa-award"></i>
          <span>{{doctor.experience}} yil</span>
        </div>
        <div class="doc-stat">
          <i class="fas fa-door-open"></i>
          <span>Xona {{doctor.room_number}}</span>
        </div>
      </div>
      {{#if doctor.bio}}
        <p class="text-muted small mt-3 mb-0" style="line-height:1.5;">{{doctor.bio}}</p>
      {{/if}}
    </div>
  </div>

  <!-- Booking -->
  <div class="col-md-8">
    {{#if schedules.length}}
      <div class="sc-card booking-card">
        <h6 class="fw-bold mb-4" style="color:#334155;">
          <i class="fas fa-clock me-2 text-success"></i>Ish kunlari va vaqtni tanlang
        </h6>

        <!-- Day Buttons -->
        <div class="mf-field">
          <label class="mf-label"><i class="fas fa-calendar-week" style="color:#10b981;"></i> Ish kuni</label>
          <div class="day-grid" id="dayBtns" role="group" aria-label="Ish kunlarini tanlang">
            {{#each schedules}}
              <button type="button" class="day-btn" data-day="{{this.work_day}}"
                data-start="{{this.start_time}}" data-end="{{this.end_time}}">
                <span class="day-name">{{#if (eq this.work_day "monday")}}Dushanba{{else if (eq this.work_day "tuesday")}}Seshanba{{else if (eq this.work_day "wednesday")}}Chorshanba{{else if (eq this.work_day "thursday")}}Payshanba{{else if (eq this.work_day "friday")}}Juma{{else if (eq this.work_day "saturday")}}Shanba{{else}}Yakshanba{{/if}}</span>
                <small class="day-time">{{this.start_time}}–{{this.end_time}}</small>
              </button>
            {{/each}}
          </div>
        </div>

        <!-- Date -->
        <div class="mf-field" id="dateSection" style="display:none;">
          <label class="mf-label"><i class="fas fa-calendar" style="color:#10b981;"></i> Sana tanlang</label>
          <input type="date" class="mf-input" id="appointment_date">
          <p class="mf-hint" id="dateHint"></p>
        </div>

        <!-- Time Slots -->
        <div id="timeSection" style="display:none;">
          <div class="mf-field">
            <label class="mf-label"><i class="fas fa-clock" style="color:#10b981;"></i> Vaqt tanlang</label>
            <div class="slot-grid" id="slotGrid" role="group" aria-label="Mavjud vaqt slotlari"></div>
            <p class="mf-hint" id="timeHint"></p>
          </div>
          <button class="btn-book-now w-100" id="submitBtn" style="display:none;">
            <i class="fas fa-calendar-check me-2"></i>Qabulga yozilish
          </button>
        </div>
      </div>
    {{else}}
      <div class="sc-card text-center py-5">
        <i class="fas fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
        <h5 class="text-muted mb-2">Jadval kiritilmagan</h5>
        <p class="text-muted mb-4">Bu shifokor hozircha ish jadvalini kiritmagan</p>
        <a href="/departments" class="btn-back-link">
          <i class="fas fa-arrow-left me-2"></i>Boshqa bo'limlar
        </a>
      </div>
    {{/if}}
  </div>
</div>

<script>
const doctorId = '{{doctor._id}}';
const schedules = [
  {{#each schedules}}
  { day: '{{this.work_day}}', start: '{{this.start_time}}', end: '{{this.end_time}}', break_start: '{{this.break_start}}', break_end: '{{this.break_end}}', slot_duration: {{#if this.slot_duration}}{{this.slot_duration}}{{else}}30{{/if}} },
  {{/each}}
];
const dayMap = { monday:1, tuesday:2, wednesday:3, thursday:4, friday:5, saturday:6, sunday:0 };
let selectedDay = null, selectedTime = null;

document.querySelectorAll('.day-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedDay = btn.dataset.day;
    selectedTime = null;

    const targetDow = dayMap[selectedDay];
    const today = new Date(); today.setHours(0,0,0,0);
    let d = new Date(today);
    for (let i = 0; i < 7; i++) {
      if (d.getDay() === targetDow) break;
      d.setDate(d.getDate() + 1);
    }
    const minDate = d.toISOString().split('T')[0];
    const dateInput = document.getElementById('appointment_date');
    dateInput.value = minDate;
    dateInput.min = minDate;
    document.getElementById('dateHint').textContent = `Ish vaqti: ${btn.dataset.start} – ${btn.dataset.end}`;
    document.getElementById('dateSection').style.display = 'block';

    dateInput.onchange = async () => {
      const chosen = new Date(dateInput.value + 'T00:00:00');
      if (chosen.getDay() !== targetDow) {
        document.getElementById('dateHint').textContent = `Faqat ${selectedDay} kunlari tanlansin`;
        dateInput.value = minDate;
      } else {
        await loadSlots(dateInput.value);
      }
    };
    await loadSlots(minDate);
  });
});

async function loadSlots(date) {
  const grid = document.getElementById('slotGrid');
  grid.innerHTML = '<span class="text-muted small">Yuklanmoqda...</span>';
  document.getElementById('timeSection').style.display = 'block';
  document.getElementById('submitBtn').style.display = 'none';
  selectedTime = null;

  const sched = schedules.find(s => s.day === selectedDay);
  let booked = [];
  try {
    const res = await fetch(`/api/appointment/available-slots?doctor_id=${doctorId}&date=${date}`);
    if (res.ok) booked = (await res.json()).data || [];
  } catch {}

  const slots = genSlots(sched.start, sched.end, booked, sched.break_start, sched.break_end, sched.slot_duration || 30);
  grid.innerHTML = '';
  slots.forEach(s => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'slot-btn';
    btn.textContent = s.time;
    btn.disabled = s.booked || s.isBreak;
    if (!btn.disabled) {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedTime = s.time;
        document.getElementById('submitBtn').style.display = 'flex';
      });
    }
    grid.appendChild(btn);
  });
  const free = slots.filter(s => !s.booked && !s.isBreak).length;
  document.getElementById('timeHint').textContent = `${free} ta bo'sh slot mavjud`;
}

function genSlots(start, end, booked, brkS, brkE, slotDuration) {
  const slots = [];
  let [h, m] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  while (h < eh || (h === eh && m < em)) {
    const time = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
    const isBreak = brkS && brkE ? time >= brkS && time < brkE : h === 13;
    slots.push({ time, booked: booked.includes(time), isBreak });
    m += slotDuration; if (m >= 60) { h += Math.floor(m / 60); m = m % 60; }
  }
  return slots;
}

document.getElementById('submitBtn')?.addEventListener('click', async () => {
  const date = document.getElementById('appointment_date').value;
  if (!date || !selectedTime) return Toast.error('Sana va vaqtni tanlang');
  const appointment_date = new Date(`${date}T${selectedTime}:00`).toISOString();
  try {
    const res = await fetch('/api/appointment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ doctor_id: doctorId, appointment_date }),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      Toast.success('Qabulga muvaffaqiyatli yozildingiz');
      setTimeout(() => window.location.href = '/patient/appointments', 1500);
    } else {
      Toast.error(data.message || 'Xatolik yuz berdi');
    }
  } catch { Toast.error('Tarmoq xatosi'); }
});
</script>
