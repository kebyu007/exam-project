<div class="forgot-wrap sc-fade">
  <div class="forgot-card">
    <div class="text-center mb-4">
      <div class="service-icon purple mx-auto mb-3"><i class="fas fa-key"></i></div>
      <h3 class="fw-bold mb-1">Parolni tiklash</h3>
      <p class="text-muted small">Emailingizni kiriting, parolni tiklash havolasi yuboramiz</p>
    </div>

    <div id="msg"></div>

    <form id="forgotForm">
      <div class="mf-field">
        <label class="mf-label"><i class="fas fa-envelope"></i> Email</label>
        <input type="email" class="mf-input" name="email" id="forgotEmail" placeholder="email@example.com" required>
        <div class="field-error" id="forgotEmailError">To'g'ri email kiriting</div>
      </div>
      <button type="submit" class="btn-auth-submit w-100 mb-3">
        <i class="fas fa-paper-plane me-2"></i>Yuborish
      </button>
    </form>

    <div class="text-center">
      <a href="/login" class="small text-muted"><i class="fas fa-arrow-left me-1"></i>Kirishga qaytish</a>
    </div>
  </div>
</div>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('forgotEmail');
  const errEl = document.getElementById('forgotEmailError');
  const msg = document.getElementById('msg');

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
    email.classList.add('mf-invalid'); errEl.classList.add('show'); return;
  }
  email.classList.remove('mf-invalid'); errEl.classList.remove('show');

  try {
    const res = await fetch('/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email.value }),
    });
    const data = await res.json();
    if (res.ok) {
      msg.innerHTML = '<div class="alert alert-success">Havola emailga yuborildi!</div>';
      e.target.reset();
    } else {
      Toast.error(data.message || 'Xatolik yuz berdi');
    }
  } catch { Toast.error('Tarmoq xatosi'); }
});
</script>
