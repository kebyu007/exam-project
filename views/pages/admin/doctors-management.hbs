<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Shifokorlarni boshqarish</h1>
  <a href="/admin/add-doctor" class="btn btn-primary">
    <i class="bi bi-plus-circle"></i> Yangi shifokor qo'shish
  </a>
</div>

{{#if doctors.length}}
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Ism</th>
          <th>Email</th>
          <th>Mutaxassislik</th>
          <th>Tajriba</th>
          <th>Xona</th>
          <th>Amallar</th>
        </tr>
      </thead>
      <tbody>
        {{#each doctors}}
          <tr>
            <td>{{this.user_id.full_name}}</td>
            <td>{{this.user_id.email}}</td>
            <td>{{this.specialization}}</td>
            <td>{{this.experience}} yil</td>
            <td>{{this.room_number}}</td>
            <td>
              <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal{{this._id}}">Tahrirlash</button>
              <form action="/admin/doctors/{{this._id}}/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Ishonchingiz komilmi?')">O'chirish</button>
              </form>
            </td>
          </tr>

          <!-- Edit Modal -->
          <div class="modal fade" id="editModal{{this._id}}" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Shifokorni tahrirlash</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/doctors/{{this._id}}/update" method="POST">
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Mutaxassislik</label>
                      <input type="text" class="form-control" name="specialization" value="{{this.specialization}}" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Tajriba (yil)</label>
                      <input type="number" class="form-control" name="experience" value="{{this.experience}}" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Xona raqami</label>
                      <input type="text" class="form-control" name="room_number" value="{{this.room_number}}" required>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                    <button type="submit" class="btn btn-primary">Saqlash</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="alert alert-info">Hozircha shifokorlar yo'q.</div>
{{/if}}
