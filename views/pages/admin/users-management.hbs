<div class="page-header sc-fade">
  <div class="page-header-left">
    <div class="page-header-icon purple"><i class="fas fa-users"></i></div>
    <div>
      <h2>Foydalanuvchilar boshqaruvi</h2>
      <p>Foydalanuvchilar rollarini boshqarish</p>
    </div>
  </div>
  {{#if users.length}}<span class="count-badge purple">{{users.length}} ta</span>{{/if}}
</div>

{{#if users.length}}
  <div class="row g-4">
    {{#each users}}
      <div class="col-md-6 col-lg-4 animate-slide-up" style="animation-delay: {{multiply @index 0.05}}s;">
        <div class="user-card h-100">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="user-avatar">
              <i class="fas {{#if (eq this.role 'doctor')}}fa-user-md{{else if (eq this.role 'admin')}}fa-user-shield{{else}}fa-user{{/if}}"></i>
            </div>
            <div class="flex-grow-1 min-w-0">
              <h6 class="mb-1 fw-bold text-truncate">{{this.full_name}}</h6>
              <p class="text-muted small mb-0 text-truncate">
                <i class="fas fa-envelope me-1"></i>{{this.email}}
              </p>
            </div>
          </div>

          <div class="d-flex gap-2 mb-3">
            <span class="role-badge {{#if (eq this.role 'admin')}}role-admin{{else if (eq this.role 'doctor')}}role-doctor{{else}}role-patient{{/if}}">
              {{#if (eq this.role 'admin')}}Admin{{else if (eq this.role 'doctor')}}Shifokor{{else}}Bemor{{/if}}
            </span>
            <span class="status-badge {{#if this.is_active}}status-active{{else}}status-inactive{{/if}}">
              <i class="fas {{#if this.is_active}}fa-circle{{else}}fa-circle{{/if}} me-1" style="font-size:6px;vertical-align:middle;"></i>
              {{#if this.is_active}}Faol{{else}}Nofaol{{/if}}
            </span>
          </div>

          <button class="btn-change-role w-100" data-bs-toggle="modal" data-bs-target="#roleModal{{this._id}}">
            <i class="fas fa-user-cog me-2"></i>Rolni o'zgartirish
          </button>
        </div>
      </div>

      <!-- Role Change Modal -->
      <div class="modal fade" id="roleModal{{this._id}}" tabindex="-1" aria-labelledby="roleModalLabel{{this._id}}" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content modern-modal">
            <div class="modern-modal-header">
              <div class="d-flex align-items-center gap-3">
                <div class="modal-user-avatar">
                  <i class="fas fa-user-cog"></i>
                </div>
                <div>
                  <h5 class="mb-0 fw-bold">Rolni o'zgartirish</h5>
                  <small class="opacity-75">{{this.full_name}}</small>
                </div>
              </div>
              <button type="button" class="modal-close-btn" data-bs-dismiss="modal">
                <i class="fas fa-times"></i>
              </button>
            </div>

            <form action="/admin/users/{{this._id}}/role" method="POST">
              <div class="modern-modal-body">

                <div class="modern-field">
                  <label class="modern-label">
                    <i class="fas fa-user-tag"></i> Yangi rol
                  </label>
                  <div class="modern-select-wrapper">
                    <select class="modern-select" name="role" required
                      onchange="toggleDoctorFields('{{this._id}}', this.value)">
                      <option value="patient" {{#if (eq this.role 'patient')}}selected{{/if}}>👤 Bemor</option>
                      <option value="doctor" {{#if (eq this.role 'doctor')}}selected{{/if}}>🩺 Shifokor</option>
                      <option value="admin" {{#if (eq this.role 'admin')}}selected{{/if}}>🛡️ Admin</option>
                    </select>
                    <i class="fas fa-chevron-down select-arrow"></i>
                  </div>
                </div>

                <!-- Doctor extra fields -->
                <div id="doctorFields{{this._id}}" class="doctor-fields" style="display:{{#if (eq this.role 'doctor')}}block{{else}}none{{/if}}">
                  <div class="doctor-fields-divider">
                    <span><i class="fas fa-stethoscope me-2"></i>Shifokor ma'lumotlari</span>
                  </div>

                  <div class="modern-field">
                    <label class="modern-label">
                      <i class="fas fa-building"></i> Bo'lim
                    </label>
                    <div class="modern-select-wrapper">
                      <select class="modern-select" name="department_id">
                        <option value="">Bo'limni tanlang</option>
                        {{#each ../departments}}
                          <option value="{{this._id}}" {{#if (eq this._id ../doctorInfo.department_id)}}selected{{/if}}>
                            {{this.name}}
                          </option>
                        {{/each}}
                      </select>
                      <i class="fas fa-chevron-down select-arrow"></i>
                    </div>
                  </div>

                  <div class="modern-field">
                    <label class="modern-label">
                      <i class="fas fa-stethoscope"></i> Mutaxassislik
                    </label>
                    <input type="text" class="modern-input" name="specialization"
                      value="{{this.doctorInfo.specialization}}"
                      placeholder="Masalan: Kardiolog">
                  </div>

                  <div class="row g-3">
                    <div class="col-6">
                      <div class="modern-field">
                        <label class="modern-label">
                          <i class="fas fa-calendar-alt"></i> Tajriba (yil)
                        </label>
                        <input type="number" class="modern-input" name="experience" min="0"
                          value="{{#if this.doctorInfo.experience}}{{this.doctorInfo.experience}}{{else}}0{{/if}}"
                          placeholder="0">
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="modern-field">
                        <label class="modern-label">
                          <i class="fas fa-door-open"></i> Xona raqami
                        </label>
                        <input type="text" class="modern-input" name="room_number"
                          value="{{this.doctorInfo.room_number}}"
                          placeholder="101">
                      </div>
                    </div>
                  </div>

                  <div class="modern-field">
                    <label class="modern-label">
                      <i class="fas fa-file-alt"></i> Biografiya
                    </label>
                    <textarea class="modern-input modern-textarea" name="bio" rows="3"
                      placeholder="Shifokor haqida qisqacha ma'lumot...">{{this.doctorInfo.bio}}</textarea>
                  </div>
                </div>
              </div>

              <div class="modern-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">
                  <i class="fas fa-times me-2"></i>Bekor qilish
                </button>
                <button type="submit" class="btn-modal-save">
                  <i class="fas fa-save me-2"></i>Saqlash
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="text-center py-5 animate-fade-in">
    <i class="fas fa-users fa-5x text-muted mb-3"></i>
    <h4 class="text-muted">Hozircha foydalanuvchilar yo'q</h4>
  </div>
{{/if}}

<script>
function toggleDoctorFields(userId, role) {
  document.getElementById('doctorFields' + userId).style.display = role === 'doctor' ? 'block' : 'none';
}
</script>
