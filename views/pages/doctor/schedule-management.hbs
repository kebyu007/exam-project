<div class="page-header sc-fade">
  <div class="page-header-left">
    <div class="page-header-icon blue"><i class="fas fa-calendar-alt"></i></div>
    <div>
      <h2>Ish jadvali</h2>
      <p>Ish vaqtingizni belgilang va boshqaring</p>
    </div>
  </div>
</div>

<div class="row mb-4 justify-content-center">
  <div class="col-lg-10 sc-slide">
    <div class="form-section">
      <div class="form-section-header">
        <ul class="nav nav-pills" id="scheduleTab" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#single" type="button">
              <i class="fas fa-calendar-day me-2"></i>Kunlik
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#weekly" type="button">
              <i class="fas fa-calendar-week me-2"></i>Haftalik
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#range" type="button">
              <i class="fas fa-calendar-alt me-2"></i>Diapazon
            </button>
          </li>
        </ul>
      </div>
      <div class="form-section-body">
        <div class="tab-content">

          <div class="tab-pane fade show active" id="single">
            <form action="/doctor/schedule" method="POST" aria-label="Jadval qo'shish">
              <input type="hidden" name="type" value="single">
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-calendar" style="color:#3b82f6;"></i> Sana</label>
                    <input type="date" class="mf-input" name="start_date" required min="{{today}}">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-play" style="color:#3b82f6;"></i> Boshlanish</label>
                    <input type="time" class="mf-input" name="start_time" value="08:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-stop" style="color:#3b82f6;"></i> Tugash</label>
                    <input type="time" class="mf-input" name="end_time" value="17:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik boshi</label>
                    <input type="time" class="mf-input" name="break_start" value="13:00">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik tugashi</label>
                    <input type="time" class="mf-input" name="break_end" value="14:00">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-hourglass-half" style="color:#3b82f6;"></i> Slot (daqiqa)</label>
                    <div class="mf-select-wrap">
                      <select class="mf-select mf-input" name="slot_duration">
                        <option value="15">15 daqiqa</option>
                        <option value="20">20 daqiqa</option>
                        <option value="30" selected>30 daqiqa</option>
                        <option value="45">45 daqiqa</option>
                        <option value="60">1 soat</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-comment" style="color:#94a3b8;"></i> Izoh (ixtiyoriy)</label>
                    <input type="text" class="mf-input" name="note" placeholder="Masalan: Bayram kuni qisqartirilgan ish kuni">
                  </div>
                </div>
              </div>
              <button type="submit" class="btn-submit mt-3">
                <i class="fas fa-plus me-2"></i>Qo'shish
              </button>
            </form>
          </div>

          <div class="tab-pane fade" id="weekly">
            <form action="/doctor/schedule" method="POST" aria-label="Jadval qo'shish">
              <input type="hidden" name="type" value="weekly">
              <div class="mf-field">
                <label class="mf-label"><i class="fas fa-calendar-week" style="color:#3b82f6;"></i> Ish kunlari</label>
                <div class="weekday-grid">
                  {{#each (array "monday" "tuesday" "wednesday" "thursday" "friday" "saturday")}}
                    <label class="weekday-chip">
                      <input type="checkbox" name="work_days" value="{{this}}" class="d-none">
                      <span>{{#if (eq this "monday")}}Du{{else if (eq this "tuesday")}}Se{{else if (eq this "wednesday")}}Ch{{else if (eq this "thursday")}}Pa{{else if (eq this "friday")}}Ju{{else}}Sh{{/if}}</span>
                    </label>
                  {{/each}}
                </div>
              </div>
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-play" style="color:#3b82f6;"></i> Boshlanish</label>
                    <input type="time" class="mf-input" name="start_time" value="08:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-stop" style="color:#3b82f6;"></i> Tugash</label>
                    <input type="time" class="mf-input" name="end_time" value="17:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-hourglass-half" style="color:#3b82f6;"></i> Slot (daqiqa)</label>
                    <div class="mf-select-wrap">
                      <select class="mf-select mf-input" name="slot_duration">
                        <option value="15">15 daqiqa</option>
                        <option value="20">20 daqiqa</option>
                        <option value="30" selected>30 daqiqa</option>
                        <option value="45">45 daqiqa</option>
                        <option value="60">1 soat</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik boshi</label>
                    <input type="time" class="mf-input" name="break_start" value="13:00">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik tugashi</label>
                    <input type="time" class="mf-input" name="break_end" value="14:00">
                  </div>
                </div>
              </div>
              <button type="submit" class="btn-submit mt-3">
                <i class="fas fa-plus me-2"></i>Qo'shish
              </button>
            </form>
          </div>

          <div class="tab-pane fade" id="range">
            <form action="/doctor/schedule" method="POST" aria-label="Jadval qo'shish">
              <input type="hidden" name="type" value="range">
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-calendar-plus" style="color:#3b82f6;"></i> Boshlanish sanasi</label>
                    <input type="date" class="mf-input" name="start_date" required min="{{today}}">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-calendar-minus" style="color:#3b82f6;"></i> Tugash sanasi</label>
                    <input type="date" class="mf-input" name="end_date" required min="{{today}}">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-hourglass-half" style="color:#3b82f6;"></i> Slot (daqiqa)</label>
                    <div class="mf-select-wrap">
                      <select class="mf-select mf-input" name="slot_duration">
                        <option value="15">15 daqiqa</option>
                        <option value="20">20 daqiqa</option>
                        <option value="30" selected>30 daqiqa</option>
                        <option value="45">45 daqiqa</option>
                        <option value="60">1 soat</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-play" style="color:#3b82f6;"></i> Boshlanish vaqti</label>
                    <input type="time" class="mf-input" name="start_time" value="08:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-stop" style="color:#3b82f6;"></i> Tugash vaqti</label>
                    <input type="time" class="mf-input" name="end_time" value="17:00" required>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik boshi</label>
                    <input type="time" class="mf-input" name="break_start" value="13:00">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik tugashi</label>
                    <input type="time" class="mf-input" name="break_end" value="14:00">
                  </div>
                </div>
                <div class="col-12">
                  <div class="mf-field mb-0">
                    <label class="mf-label"><i class="fas fa-comment" style="color:#94a3b8;"></i> Izoh (ixtiyoriy)</label>
                    <input type="text" class="mf-input" name="note" placeholder="Masalan: Iyun oyi jadvali">
                  </div>
                </div>
              </div>
              <button type="submit" class="btn-submit mt-3">
                <i class="fas fa-plus me-2"></i>Qo'shish
              </button>
            </form>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

{{#if schedules.length}}
  <div class="d-flex align-items-center gap-3 mb-3 sc-fade">
    <h5 class="mb-0 fw-bold">Mavjud jadvallar</h5>
    <span class="count-badge blue">{{schedules.length}}</span>
    <form action="/doctor/schedule/delete-all" method="POST" class="ms-auto"
      onsubmit="return confirm('Barcha jadvallarni o\'chirishni tasdiqlaysizmi?')">
      <button type="submit" class="btn-danger-sm">
        <i class="fas fa-trash me-1"></i>Hammasini o'chirish
      </button>
    </form>
  </div>

  <div class="row g-3">
    {{#each schedules}}
      <div class="col-md-6 sc-slide" style="animation-delay:{{multiply @index 0.05}}s;">
        <div class="sc-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              {{#if this.date}}
                <span class="sched-type blue">Kunlik</span>
                <h6 class="mb-0 mt-1 fw-bold">{{formatDate this.date}}</h6>
              {{else if this.work_day}}
                <span class="sched-type green">Haftalik</span>
                <h6 class="mb-0 mt-1 fw-bold">{{weekDayUz this.work_day}}</h6>
              {{else}}
                <span class="sched-type">—</span>
              {{/if}}
            </div>
            <span class="appt-status {{#if this.is_available}}confirmed{{else}}cancelled{{/if}}">
              {{#if this.is_available}}Faol{{else}}Nofaol{{/if}}
            </span>
          </div>

          <div class="sched-meta mb-3">
            <span><i class="fas fa-clock me-1"></i>{{this.start_time}} – {{this.end_time}}</span>
            {{#if this.break_start}}<span><i class="fas fa-coffee me-1"></i>{{this.break_start}} – {{this.break_end}}</span>{{/if}}
            <span><i class="fas fa-hourglass-half me-1"></i>{{#if this.slot_duration}}{{this.slot_duration}}{{else}}30{{/if}} daq</span>
          </div>

          <div class="d-flex gap-2">
            <button type="button" class="btn-outline-edit flex-grow-1" data-bs-toggle="modal" data-bs-target="#editModal{{this._id}}">
              <i class="fas fa-edit me-1"></i>Tahrirlash
            </button>
            <form action="/doctor/schedule/{{this._id}}/delete" method="POST" class="flex-grow-1"
              onsubmit="return confirm('Jadvalni o\'chirishni tasdiqlaysizmi?')">
              <button type="submit" class="btn-outline-del w-100">
                <i class="fas fa-trash me-1"></i>O'chirish
              </button>
            </form>
          </div>
        </div>
      </div>

      <div class="modal fade" id="editModal{{this._id}}" tabindex="-1" aria-labelledby="editModalLabel{{this._id}}" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
          <div class="mm-modal modal-content">
            <div class="mm-header blue">
              <div class="d-flex align-items-center gap-3">
                <div class="mm-header-icon"><i class="fas fa-calendar-alt"></i></div>
                <div>
                  <h6 class="mb-0 fw-bold">Jadvalni tahrirlash</h6>
                  <small class="opacity-75">{{#if this.date}}{{formatDate this.date}}{{else}}{{weekDayUz this.work_day}}{{/if}}</small>
                </div>
              </div>
              <button type="button" class="mm-close" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <form action="/doctor/schedule/{{this._id}}/update" method="POST">
              <div class="mm-body">
                <div class="row g-3">
                  <div class="col-6">
                    <div class="mf-field mb-0">
                      <label class="mf-label"><i class="fas fa-play" style="color:#3b82f6;"></i> Boshlanish</label>
                      <input type="time" class="mf-input" name="start_time" value="{{this.start_time}}" required>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="mf-field mb-0">
                      <label class="mf-label"><i class="fas fa-stop" style="color:#3b82f6;"></i> Tugash</label>
                      <input type="time" class="mf-input" name="end_time" value="{{this.end_time}}" required>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="mf-field mb-0">
                      <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik boshi</label>
                      <input type="time" class="mf-input" name="break_start" value="{{this.break_start}}">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="mf-field mb-0">
                      <label class="mf-label"><i class="fas fa-coffee" style="color:#94a3b8;"></i> Tushlik tugashi</label>
                      <input type="time" class="mf-input" name="break_end" value="{{this.break_end}}">
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="mf-field mb-0">
                      <label class="mf-label"><i class="fas fa-hourglass-half" style="color:#3b82f6;"></i> Slot (daqiqa)</label>
                      <div class="mf-select-wrap">
                        <select class="mf-select mf-input" name="slot_duration">
                          <option value="15" {{#if (eq this.slot_duration 15)}}selected{{/if}}>15 daqiqa</option>
                          <option value="20" {{#if (eq this.slot_duration 20)}}selected{{/if}}>20 daqiqa</option>
                          <option value="30" {{#if (eq this.slot_duration 30)}}selected{{else}}{{#unless this.slot_duration}}selected{{/unless}}{{/if}}>30 daqiqa</option>
                          <option value="45" {{#if (eq this.slot_duration 45)}}selected{{/if}}>45 daqiqa</option>
                          <option value="60" {{#if (eq this.slot_duration 60)}}selected{{/if}}>1 soat</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mm-footer">
                <button type="button" class="mm-btn-cancel" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Bekor</button>
                <button type="submit" class="mm-btn-save blue"><i class="fas fa-save me-1"></i>Saqlash</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="text-center py-5 sc-fade">
    <i class="fas fa-calendar-times fa-4x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">Hozircha jadval yo'q</h5>
  </div>
{{/if}}

