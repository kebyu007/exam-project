<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Smart Clinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  {{> navbar}}
  
  <main class="container my-4">
    {{{body}}}
  </main>

  {{> footer}}
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/toast.js"></script>
  <script>
    const _tp = new URLSearchParams(location.search).get('toast');
    const _ep = new URLSearchParams(location.search).get('error');
    if (_tp) document.addEventListener('DOMContentLoaded', () => Toast.success(_tp));
    if (_ep) document.addEventListener('DOMContentLoaded', () => Toast.error(_ep));
  </script>
</body>
</html>
