<div class="auth-wrap sc-fade">
  <div class="auth-card">
    <div class="auth-side">
      <i class="fas fa-hospital fa-5x mb-4 animate-float"></i>
      <h2 class="fw-bold mb-2">Smart Clinic</h2>
      <p>Sog'ligingiz bizning g'amxo'rligimiz</p>
    </div>
    <div class="auth-form-side">
      <div class="text-center mb-4">
        <h3 class="fw-bold mb-1"><i class="fas fa-sign-in-alt text-primary me-2"></i>Kirish</h3>
        <p class="text-muted small">Hisobingizga kiring</p>
      </div>

      <form id="loginForm" novalidate>
        <div class="mf-field">
          <label class="mf-label"><i class="fas fa-envelope"></i> Email</label>
          <input type="email" class="mf-input" id="email" name="email" placeholder="email@example.com" required>
          <div class="field-error" id="emailError">To'g'ri email kiriting</div>
        </div>
        <div class="mf-field">
          <label class="mf-label"><i class="fas fa-lock"></i> Parol</label>
          <div class="mf-pass-wrap">
            <input type="password" class="mf-input" id="password" name="password" placeholder="••••••••" required>
            <button type="button" class="mf-pass-toggle" onclick="toggleMfPass('password',this)" tabindex="-1"><i class="fas fa-eye"></i></button>
          </div>
          <div class="field-error" id="passwordError">Parol kiritilmagan</div>
        </div>
        <button type="submit" class="btn-auth-submit w-100 mb-3">
          <i class="fas fa-sign-in-alt me-2"></i>Kirish
        </button>
      </form>

      <div class="text-center">
        <p class="mb-2 small">Hisobingiz yo'qmi? <a href="/register" class="fw-semibold">Ro'yxatdan o'ting</a></p>
        <a href="/forgot-password" class="small text-muted"><i class="fas fa-question-circle me-1"></i>Parolni unutdingizmi?</a>
      </div>
    </div>
  </div>
</div>

<script>
function toggleMfPass(id, btn) {
  const input = document.getElementById(id);
  const icon = btn.querySelector('i');
  input.type = input.type === 'password' ? 'text' : 'password';
  icon.className = input.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}

document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('email');
  const password = document.getElementById('password');
  let valid = true;

  const showErr = (id, msg) => {
    const el = document.getElementById(id);
    msg ? (el.textContent = msg, el.classList.add('show')) : el.classList.remove('show');
  };

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
    email.classList.add('mf-invalid'); showErr('emailError', "To'g'ri email kiriting"); valid = false;
  } else { email.classList.remove('mf-invalid'); showErr('emailError', ''); }

  if (!password.value) {
    password.classList.add('mf-invalid'); showErr('passwordError', 'Parol kiritilmagan'); valid = false;
  } else { password.classList.remove('mf-invalid'); showErr('passwordError', ''); }

  if (!valid) return;

  try {
    const res = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email.value, password: password.value })
    });
    const data = await res.json();
    if (res.ok) {
      Toast.success('Tizimga muvaffaqiyatli kirdingiz');
      setTimeout(() => window.location.href = data.redirect || '/', 1000);
    } else {
      Toast.error(Array.isArray(data.message) ? data.message[0] : data.message || 'Kirish xatosi');
    }
  } catch { Toast.error('Tarmoq xatosi'); }
});
</script>
