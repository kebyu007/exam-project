<h1 class="mb-4">Ish jadvali</h1>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Yangi jadval qo'shish</h5>
        <form action="/doctor/schedule" method="POST">
          <div class="mb-3">
            <label for="work_day" class="form-label">Ish kuni</label>
            <select class="form-select" id="work_day" name="work_day" required>
              <option value="monday">Dushanba</option>
              <option value="tuesday">Seshanba</option>
              <option value="wednesday">Chorshanba</option>
              <option value="thursday">Payshanba</option>
              <option value="friday">Juma</option>
              <option value="saturday">Shanba</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="start_time" class="form-label">Boshlanish vaqti</label>
            <input type="time" class="form-control" id="start_time" name="start_time" required>
          </div>
          <div class="mb-3">
            <label for="end_time" class="form-label">Tugash vaqti</label>
            <input type="time" class="form-control" id="end_time" name="end_time" required>
          </div>
          <button type="submit" class="btn btn-primary">Qo'shish</button>
        </form>
      </div>
    </div>
  </div>
</div>

{{#if schedules.length}}
  <h3>Mavjud jadvallar</h3>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Kun</th>
          <th>Boshlanish</th>
          <th>Tugash</th>
          <th>Amallar</th>
        </tr>
      </thead>
      <tbody>
        {{#each schedules}}
          <tr>
            <td>{{this.work_day}}</td>
            <td>{{this.start_time}}</td>
            <td>{{this.end_time}}</td>
            <td>
              <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editSchedule{{this._id}}">Tahrirlash</button>
              <form action="/doctor/schedule/{{this._id}}/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger">O'chirish</button>
              </form>
            </td>
          </tr>

          <div class="modal fade" id="editSchedule{{this._id}}" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Jadvalni tahrirlash</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/doctor/schedule/{{this._id}}/update" method="POST">
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Ish kuni</label>
                      <select class="form-select" name="work_day" required>
                        <option value="monday" {{#if (eq this.work_day 'monday')}}selected{{/if}}>Dushanba</option>
                        <option value="tuesday" {{#if (eq this.work_day 'tuesday')}}selected{{/if}}>Seshanba</option>
                        <option value="wednesday" {{#if (eq this.work_day 'wednesday')}}selected{{/if}}>Chorshanba</option>
                        <option value="thursday" {{#if (eq this.work_day 'thursday')}}selected{{/if}}>Payshanba</option>
                        <option value="friday" {{#if (eq this.work_day 'friday')}}selected{{/if}}>Juma</option>
                        <option value="saturday" {{#if (eq this.work_day 'saturday')}}selected{{/if}}>Shanba</option>
                      </select>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Boshlanish vaqti</label>
                      <input type="time" class="form-control" name="start_time" value="{{this.start_time}}" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Tugash vaqti</label>
                      <input type="time" class="form-control" name="end_time" value="{{this.end_time}}" required>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                    <button type="submit" class="btn btn-primary">Saqlash</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="alert alert-info">Hozircha jadval yo'q.</div>
{{/if}}
