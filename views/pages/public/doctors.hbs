<h1 class="mb-4">Shifokorlar</h1>

<div class="row">
  {{#each doctors}}
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="text-center pt-4">
          {{#if this.user_id.profile}}
            <img src="/uploads/user-profile/{{this.user_id.profile}}"
              class="rounded-circle border"
              width="100" height="100"
              style="object-fit:cover;">
          {{else}}
            <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center"
              style="width:100px;height:100px;font-size:48px;">
              🩺
            </div>
          {{/if}}
        </div>
        <div class="card-body text-center">
          <h5 class="card-title mb-1">{{this.user_id.full_name}}</h5>
          <p class="text-muted small mb-2">{{this.specialization}}</p>
          <p class="card-text small">
            <i class="fas fa-clock me-1"></i>{{this.experience}} yil tajriba<br>
            <i class="fas fa-door-open me-1"></i>Xona: {{this.room_number}}
          </p>
          {{#if ../user}}
            {{#if (eq ../user.role 'patient')}}
              <a href="/patient/book/{{this._id}}" class="btn btn-primary btn-sm">Qabulga yozilish</a>
            {{/if}}
          {{else}}
            <a href="/login" class="btn btn-outline-primary btn-sm">Qabulga yozilish uchun kiring</a>
          {{/if}}
        </div>
      </div>
    </div>
  {{else}}
    <div class="col-12">
      <div class="alert alert-info">Hozircha shifokorlar mavjud emas.</div>
    </div>
  {{/each}}
</div>
